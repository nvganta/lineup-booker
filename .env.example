# Required for live lineup generation (never commit the real key)
QLOO_API_KEY=your_event_key_here

# Defaults to https://hackathon.api.qloo.com
QLOO_API_BASE=https://hackathon.api.qloo.com

# Lineup agent (Vercel AI Gateway). On Vercel, OIDC auth is automatic.
AGENT_MODEL=stealth/cat-jam
AGENT_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning-free,poolside/laguna-s-2.1-free

# Local gateway access when not on Vercel
AI_GATEWAY_API_KEY=
