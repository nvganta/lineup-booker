# Required for live lineup generation (never commit the real key)
QLOO_API_KEY=your_event_key_here

# Defaults to https://hackathon.api.qloo.com
QLOO_API_BASE=https://hackathon.api.qloo.com

# Lineup agent. "openai/…" models go straight to OpenAI when OPENAI_API_KEY
# is set; everything else goes through the Vercel AI Gateway (OIDC on Vercel).
OPENAI_API_KEY=
AGENT_MODEL=openai/gpt-5.4-mini
AGENT_FALLBACK_MODELS=stealth/cat-jam,nvidia/nemotron-3.5-lightning-free,poolside/laguna-s-2.1-free

# Local gateway access when not on Vercel
AI_GATEWAY_API_KEY=
